Options -Indexes
DirectoryIndex Default.html index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # El dominio publico canonico es el apex. Mientras www respondia 200, Google
    # veia dos copias completas del sitio compitiendo entre si.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Una sola forma por URL: sin barra final, salvo la raiz.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+?)/+$ /$1 [R=301,L]

    RewriteCond %{REQUEST_URI} ^/api(?:/|$)
    RewriteRule ^ - [R=404,L]

    RewriteRule ^$ Default.html [L]

    # Must run before the -f/-d check below, which short-circuits with [L]
    # for any request that matches a real file (every /assets/ request does).
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteRule ^ - [E=CACHE_LONG:1]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cada ruta estatica tiene su propio documento con canonical, titulo y
    # descripcion correctos. Los genera build/seo.js a partir de SITE_ROUTES;
    # ambas listas deben mantenerse sincronizadas.
    RewriteRule ^(quienes-somos|locales|eventos|promociones|buses|parqueos-inquilinos|contacto)$ $1.html [L]

    # Rutas de detalle: el codigo es dinamico, asi que se sirve una plantilla sin
    # canonical y Google usa la propia URL como canonica.
    RewriteRule ^(?:locales|eventos|promociones|buses)/[^/]+$ spa.html [L]

    # Todo lo demas no existe. Sin esta regla el SPA respondia 200 con la home
    # para cualquier URL inventada, lo que Google reporta como soft 404.
    RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ehtpQKTOs2w6nCpL5DlZGHPBZxvHW5JlAtEE+ir6LqU=' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://wspagina.centranorte.com.gt https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com/recaptcha/; frame-src https://www.googletagmanager.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"

    # Assets built by Vite carry a content hash in the filename, so they can be
    # cached forever. Without this, a stale index.html cached alongside a deploy
    # that has since replaced /assets/ can reference JS/CSS files that no longer
    # exist, causing a blank page on reload.
    Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_LONG
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        # index.html/Default.html must always be revalidated so a reload never
        # serves a stale build referencing deleted hashed assets.
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
